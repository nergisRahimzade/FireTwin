# OpenAI key for embeddings, explanations and chat; leave empty to use the offline fallback (ML-10).
OPENAI_API_KEY=
# Optional Gemini key for explanations/chat; when set it takes precedence over OpenAI.
GEMINI_API_KEY=
# 1 (default) = fixed synthetic responses from backend/app/mocks/ (BE-06).
# 0 = real API; requires the processed test table and ML artifacts.
# Docker only: leave MOCK_MODE unset/blank for automatic fallback when data/artifacts are missing.
MOCK_MODE=1
