# FireTwin .gitignore (OPS-01)
# Note: ml/artifacts/ is deliberately NOT ignored, because OPS-05 commits prebuilt model files there.

# --- Secrets ---
# .env holds real API keys; only the empty template .env.example is committed.
.env
.env.*
!.env.example

# --- Python ---
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/

# --- Data ---
# Raw PSI downloads are large and re-downloadable (make data), so keep them out of Git...
data/raw/*
# ...but keep the empty folder itself tracked.
!data/raw/.gitkeep

# Raw investigation uploads are local source inputs, not runtime/demo artifacts.
/data/BASS/
/data/BASS2/
/data/FLEX/
/data/FLEX2/
/data/SAFFIRE-II_F1C1_DistortionGrid-30mmBlock_1280x916_color/
/data/SAME/
/data/SAME-R/
/data/Saffire/
/data/Saffire2/
/data/Saffire3/
/data/raw-uploads/
/data/uploads/

# Team planning documents are private, including copies outside docs/plan/.
docs/plan/*.pdf
FireTwin*Project Overview*.pdf
FireTwin*Implementation Tasks*.pdf

# --- Vector store ---
# Local Chroma database built by ml/ingest_rag.py (ML-08); rebuild it instead of committing it.
chroma_db/

# --- Editors / OS ---
.DS_Store
