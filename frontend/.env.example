# Where the frontend sends API calls (the FireTwin FastAPI backend, contract in backend/app/schemas.py).
# Leave unset to use the defaults:
#   npm run dev   -> http://localhost:8000   (backend from `make dev`, CORS allowed for Vite by BE-05)
#   npm run build -> /api                    (same-origin; Vercel rewrites /api/* to the backend host)
# Set it only to point somewhere else, e.g. VITE_API_URL=https://firetwin-api.onrender.com
VITE_API_URL=
